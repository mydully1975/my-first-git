# 서버 설정
PORT=3000
NODE_ENV=development

# 데이터베이스 설정 (SQLite 사용)
DB_PATH=./database/quote_service.db

# JWT 설정
JWT_SECRET=test_secret_key_for_development_only
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=test_refresh_secret_key_for_development_only
JWT_REFRESH_EXPIRE=30d

# 파일 업로드 설정 (로컬 저장소 사용)
UPLOAD_DIR=./uploads

# 앱 설정
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
